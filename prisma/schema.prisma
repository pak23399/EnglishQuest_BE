generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EFMigrationsHistory {
  MigrationId    String @id(map: "PK___EFMigrationsHistory") @db.VarChar(150)
  ProductVersion String @db.VarChar(32)

  @@map("__EFMigrationsHistory")
}

model ai_usage_logs {
  id              String    @id(map: "PK_ai_usage_logs") @db.Uuid
  user_id         String    @db.Uuid
  feature_type    Int
  used_at         DateTime  @db.Timestamptz(6)
  request_summary String?   @db.VarChar(500)
  tokens_used     Int
  is_success      Boolean
  error_message   String?   @db.VarChar(1000)
  created_date    DateTime? @db.Timestamptz(6)
  created_by      String?   @db.VarChar(36)
  updated_date    DateTime? @db.Timestamptz(6)
  updated_by      String?   @db.VarChar(36)
  deleted_date    DateTime? @db.Timestamptz(6)
  deleted_by      String?   @db.VarChar(36)
  is_active       Boolean
  users           users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ai_usage_logs_users_user_id")

  @@index([user_id, feature_type, used_at], map: "IX_ai_usage_logs_user_id_feature_type_used_at")
}

model authorities {
  id              String            @id(map: "PK_authorities") @db.Uuid
  key             Int               @unique(map: "IX_authorities_key")
  created_date    DateTime?         @db.Timestamptz(6)
  created_by      String?           @db.VarChar(36)
  updated_date    DateTime?         @db.Timestamptz(6)
  updated_by      String?           @db.VarChar(36)
  deleted_date    DateTime?         @db.Timestamptz(6)
  deleted_by      String?           @db.VarChar(36)
  is_active       Boolean
  roles_authority roles_authority[]
  users_authority users_authority[]
}

model exams {
  id                String          @id(map: "PK_exams") @db.Uuid
  title             String          @db.VarChar(200)
  description       String?         @db.VarChar(2000)
  duration_minutes  Int
  passing_score     Int
  xp_reward         Int
  difficulty        Int
  schedule_start    DateTime?       @db.Timestamptz(6)
  schedule_end      DateTime?       @db.Timestamptz(6)
  shuffle_questions Boolean
  shuffle_options   Boolean
  max_attempts      Int
  total_questions   Int
  created_date      DateTime?       @db.Timestamptz(6)
  created_by        String?         @db.VarChar(36)
  updated_date      DateTime?       @db.Timestamptz(6)
  updated_by        String?         @db.VarChar(36)
  deleted_date      DateTime?       @db.Timestamptz(6)
  deleted_by        String?         @db.VarChar(36)
  is_active         Boolean
  review_settings   Json?
  questions         questions[]
  quiz_attempts     quiz_attempts[]
  quiz_sessions     quiz_sessions[]
}

model file_storage {
  id           String    @id(map: "PK_file_storage") @db.Uuid
  file_name    String?
  file_size    Int?
  file_type    String?
  file_data    Bytes?
  created_date DateTime? @db.Timestamptz(6)
  created_by   String?   @db.VarChar(36)
  updated_date DateTime? @db.Timestamptz(6)
  updated_by   String?   @db.VarChar(36)
  deleted_date DateTime? @db.Timestamptz(6)
  deleted_by   String?   @db.VarChar(36)
  is_active    Boolean
}

model flashcard_decks {
  id           String       @id(map: "PK_flashcard_decks") @db.Uuid
  title        String       @db.VarChar(200)
  description  String?      @db.VarChar(1000)
  image_url    String?      @db.VarChar(500)
  order        Int
  difficulty   Int
  is_public    Boolean
  copy_count   Int
  created_date DateTime?    @db.Timestamptz(6)
  created_by   String?      @db.VarChar(36)
  updated_date DateTime?    @db.Timestamptz(6)
  updated_by   String?      @db.VarChar(36)
  deleted_date DateTime?    @db.Timestamptz(6)
  deleted_by   String?      @db.VarChar(36)
  is_active    Boolean
  user_id      String       @default(dbgenerated("'00000000-0000-0000-0000-000000000000'::uuid")) @db.Uuid
  users        users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_flashcard_decks_users_user_id")
  flashcards   flashcards[]

  @@index([is_public], map: "IX_flashcard_decks_is_public")
  @@index([user_id], map: "IX_flashcard_decks_user_id")
}

model flashcard_progress {
  id               String     @id(map: "PK_flashcard_progress") @db.Uuid
  user_id          String     @db.Uuid
  flashcard_id     String     @db.Uuid
  status           Int
  repetition_count Int
  ease_factor      Float
  interval_days    Int
  next_review_at   DateTime?  @db.Timestamptz(6)
  last_reviewed_at DateTime?  @db.Timestamptz(6)
  correct_count    Int
  incorrect_count  Int
  created_date     DateTime?  @db.Timestamptz(6)
  created_by       String?    @db.VarChar(36)
  updated_date     DateTime?  @db.Timestamptz(6)
  updated_by       String?    @db.VarChar(36)
  deleted_date     DateTime?  @db.Timestamptz(6)
  deleted_by       String?    @db.VarChar(36)
  is_active        Boolean
  flashcards       flashcards @relation(fields: [flashcard_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_flashcard_progress_flashcards_flashcard_id")
  users            users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_flashcard_progress_users_user_id")

  @@unique([user_id, flashcard_id], map: "IX_flashcard_progress_user_id_flashcard_id")
  @@index([flashcard_id], map: "IX_flashcard_progress_flashcard_id")
  @@index([next_review_at], map: "IX_flashcard_progress_next_review_at")
}

model flashcards {
  id                 String               @id(map: "PK_flashcards") @db.Uuid
  deck_id            String               @db.Uuid
  english_term       String               @db.VarChar(500)
  vietnamese_term    String               @db.VarChar(500)
  english_example    String?              @db.VarChar(1000)
  vietnamese_example String?              @db.VarChar(1000)
  pronunciation      String?              @db.VarChar(200)
  audio_url          String?              @db.VarChar(500)
  image_url          String?              @db.VarChar(500)
  difficulty         Int
  order              Int
  metadata           Json?
  created_date       DateTime?            @db.Timestamptz(6)
  created_by         String?              @db.VarChar(36)
  updated_date       DateTime?            @db.Timestamptz(6)
  updated_by         String?              @db.VarChar(36)
  deleted_date       DateTime?            @db.Timestamptz(6)
  deleted_by         String?              @db.VarChar(36)
  is_active          Boolean
  flashcard_progress flashcard_progress[]
  flashcard_decks    flashcard_decks      @relation(fields: [deck_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_flashcards_flashcard_decks_deck_id")

  @@index([deck_id], map: "IX_flashcards_deck_id")
}

model leaderboard_cache {
  id                 String    @id(map: "PK_leaderboard_cache") @db.Uuid
