  levels                 levels?         @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_quiz_sessions_levels_level_id")
  users                  users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_quiz_sessions_users_user_id")

  @@index([exam_id], map: "IX_quiz_sessions_exam_id")
  @@index([level_id], map: "IX_quiz_sessions_level_id")
  @@index([user_id], map: "IX_quiz_sessions_user_id")
}

