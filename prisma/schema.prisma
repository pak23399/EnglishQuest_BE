  updated_date              DateTime?            @db.Timestamptz(6)
  updated_by                String?              @db.VarChar(36)
  deleted_date              DateTime?            @db.Timestamptz(6)
  deleted_by                String?              @db.VarChar(36)
  is_active                 Boolean
  achievements              Json?
  current_plan              Int                  @default(0)
  email_confirmed           Boolean              @default(false)
  hearts                    Int                  @default(0)
  last_activity_at          DateTime?            @db.Timestamptz(6)
  last_heart_regenerated_at DateTime?            @db.Timestamptz(6)
  level                     Int                  @default(0)
  plan_end_date             DateTime?            @db.Timestamptz(6)
  settings                  Json?
  streak_data               Json?
  total_xp                  Int                  @default(0)
  has_bonus_heart           Boolean              @default(false)
  ai_usage_logs             ai_usage_logs[]
  flashcard_decks           flashcard_decks[]
  flashcard_progress        flashcard_progress[]
  leaderboard_cache         leaderboard_cache[]
  quiz_attempts             quiz_attempts[]
  quiz_sessions             quiz_sessions[]
  user_progress             user_progress[]
  user_subscriptions        user_subscriptions[]
  users_role                users_role[]
}

model users_authority {
  id             String       @id(map: "PK_users_authority") @db.Uuid
  users_role_id  String?      @db.Uuid
  authorities_id String?      @db.Uuid
  created_date   DateTime?    @db.Timestamptz(6)
  created_by     String?      @db.VarChar(36)
  updated_date   DateTime?    @db.Timestamptz(6)
  updated_by     String?      @db.VarChar(36)
  deleted_date   DateTime?    @db.Timestamptz(6)
  deleted_by     String?      @db.VarChar(36)
  is_active      Boolean
  authorities    authorities? @relation(fields: [authorities_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_authority_authorities_authorities_id")
  users_role     users_role?  @relation(fields: [users_role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_authority_users_role_users_role_id")

  @@index([authorities_id], map: "IX_users_authority_authorities_id")
  @@index([users_role_id], map: "IX_users_authority_users_role_id")
}

model users_role {
  id              String            @id(map: "PK_users_role") @db.Uuid
  role_id         String?           @db.Uuid
  user_id         String?           @db.Uuid
  created_date    DateTime?         @db.Timestamptz(6)
  created_by      String?           @db.VarChar(36)
  updated_date    DateTime?         @db.Timestamptz(6)
  updated_by      String?           @db.VarChar(36)
  deleted_date    DateTime?         @db.Timestamptz(6)
  deleted_by      String?           @db.VarChar(36)
  is_active       Boolean
  users_authority users_authority[]
  roles           roles?            @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_role_roles_role_id")
  users           users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_users_role_users_user_id")

  @@index([role_id], map: "IX_users_role_role_id")
  @@index([user_id], map: "IX_users_role_user_id")
}
