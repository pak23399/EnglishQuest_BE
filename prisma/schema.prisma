model quiz_attempts {
  id                 String         @id(map: "PK_quiz_attempts") @db.Uuid
  user_id            String         @db.Uuid
  level_id           String?        @db.Uuid
  section_id         String?        @db.Uuid
  score              Int
  total_questions    Int
  correct_answers    Int
  accuracy           Float
  passed             Boolean
  hearts_used        Int
  xp_earned          Int
  streak_earned      Boolean
  started_at         DateTime       @db.Timestamptz(6)
  completed_at       DateTime?      @db.Timestamptz(6)
  time_taken_seconds Int
  status             Int
  answers            Json?
  created_date       DateTime?      @db.Timestamptz(6)
  created_by         String?        @db.VarChar(36)
  updated_date       DateTime?      @db.Timestamptz(6)
  updated_by         String?        @db.VarChar(36)
  deleted_date       DateTime?      @db.Timestamptz(6)
  deleted_by         String?        @db.VarChar(36)
  is_active          Boolean
  session_id         String?        @db.Uuid
  exam_id            String?        @db.Uuid
  exams              exams?         @relation(fields: [exam_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_quiz_attempts_exams_exam_id")
  levels             levels?        @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_quiz_attempts_levels_level_id")
  quiz_sessions      quiz_sessions? @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_quiz_attempts_quiz_sessions_session_id")
  sections           sections?      @relation(fields: [section_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_quiz_attempts_sections_section_id")
  users              users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_quiz_attempts_users_user_id")

  @@index([exam_id], map: "IX_quiz_attempts_exam_id")
  @@index([level_id], map: "IX_quiz_attempts_level_id")
  @@index([section_id], map: "IX_quiz_attempts_section_id")
  @@index([session_id], map: "IX_quiz_attempts_session_id")
  @@index([user_id], map: "IX_quiz_attempts_user_id")
}

